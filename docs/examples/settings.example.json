{
  "model": "glm-5.1",
  "provider": "custom",
  "effort": "high",

  "env": {
    "ANTHROPIC_BASE_URL": "https://your-anthropic-compatible-gateway.example.com/v1",
    "ANTHROPIC_API_KEY": "sk-REPLACE-WITH-YOUR-KEY"
  },

  "subagentModelTiers": {
    "haiku": "your-cheap-fast-model",
    "sonnet": "your-mid-model",
    "opus": "glm-5.1"
  },

  "modelPricing": {
    "glm-5.1": { "input": 3, "output": 15, "cacheRead": 0.6 },
    "your-mid-model": { "input": 1.5, "output": 6 },
    "your-cheap-fast-model": { "input": 0.3, "output": 1.2 }
  },

  "fallback": {
    "enabled": true,
    "providers": [
      {
        "name": "mid-model",
        "type": "custom",
        "baseURL": "https://your-anthropic-compatible-gateway.example.com/v1",
        "apiKey": "${GATEWAY_API_KEY}",
        "model": "your-mid-model"
      },
      {
        "name": "cheap-fast-model",
        "type": "custom",
        "baseURL": "https://your-other-gateway.example.com/v1",
        "apiKey": "${OTHER_API_KEY}",
        "model": "your-cheap-fast-model"
      },
      {
        "name": "responses-model",
        "type": "custom",
        "protocol": "openai-responses",
        "baseURL": "https://your-responses-endpoint.example.com/v1",
        "apiKey": "${RESPONSES_API_KEY}",
        "model": "your-responses-model",
        "responses": {
          "stateMode": "stateless",
          "store": false
        }
      }
    ]
  },

  "permissions": {
    "defaultMode": "ask",
    "allow": ["Read", "Grep", "Glob", "LS", "TodoWrite"],
    "ask": ["Bash"],
    "deny": []
  },

  "language": "zh-CN"
}
